# Stripe Configuration (Public Publishable Key)
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here

# Backend Webhook / Cloud Functions Base URL (for processing checkout & subscription status)
BACKEND_API_URL=https://your-cloud-functions-url.cloudfunctions.net

# Firebase Web App Config (Optional if using flutterfire configure)
FIREBASE_PROJECT_ID=color-fund-prod

